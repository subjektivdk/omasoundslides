#!/bin/bash

# SPDX-FileCopyrightText: 2026 Martin Jensen
#
# SPDX-License-Identifier: MIT

# Build omasoundslides into build/. The binary ends up at build/omasoundslides.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$root/build"
cd "$root/build"
qmake6 "$root/omasoundslides.pro" CONFIG+=release
make -j"$(nproc)"
